generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectType {
  VIDEO
  LIVE
  REPO
}

model Project {
  id           String      @id @default(cuid())
  title        String
  slug         String      @unique
  summary      String
  description  String
  techStack    String[]
  type         ProjectType @default(REPO)
  videoUrl     String?
  liveUrl      String?
  repoUrl      String?
  thumbnailUrl String?
  problem      String?
  approach     String?
  outcome      String?
  order        Int         @default(0)
  published    Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([order])
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  eventName   String
  year        Int
  description String?
  imageUrl    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model Certificate {
  id                  String   @id @default(cuid())
  name                String
  issuingOrganization String
  dateEarned          DateTime
  credentialUrl       String?
  order               Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([order])
}

// Covers extracurricular activities, volunteering, and any other "outside
// coursework" involvement — kept as one model since that line is often
// blurry in practice (e.g. organizing a blood donation campaign).
model BeyondAcademicsEntry {
  id          String   @id @default(cuid())
  title       String
  role        String?
  year        String
  description String?
  imageUrl    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model Photo {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  altText   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  altText   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

enum InvolvementType {
  JOB
  CLUB
  RESEARCH_LAB
  VOLUNTEER
  OTHER
}

// Where the person currently works or is engaged — a job, a club, a research
// lab, volunteering. Distinct from BeyondAcademicsEntry (one-off activities)
// since these are ongoing affiliations with an organization and a role.
model Involvement {
  id           String          @id @default(cuid())
  organization String
  role         String
  type         InvolvementType @default(OTHER)
  period       String
  current      Boolean         @default(false)
  description  String?
  link         String?
  imageUrl     String?
  order        Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([order])
}

enum ResearchStatus {
  ONGOING
  SUBMITTED
  PUBLISHED
}

model ResearchItem {
  id          String         @id @default(cuid())
  title       String
  venue       String?
  role        String?
  year        Int
  status      ResearchStatus @default(ONGOING)
  description String?
  link        String?
  imageUrl    String?
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([order])
}

model Profile {
  id          String   @id @default("profile")
  name        String
  nickname    String?
  tagline     String
  heroIntro   String
  bio         String
  email       String
  avatarUrl   String?
  githubUrl   String?
  linkedinUrl String?
  resumeUrl   String?
  skills      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
