# PostgreSQL connection string (Supabase, Neon, or any Postgres host)
# Neon example: postgresql://user:password@host/dbname?sslmode=require
# Supabase example: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio"

# Random secret used to sign the admin session cookie (generate with: openssl rand -base64 32)
SESSION_SECRET="replace-with-a-long-random-string"

# Single admin login credentials
ADMIN_USERNAME="admin"
# Generate a bcrypt hash for your password with: npx tsx scripts/hash-password.ts "your-password"
ADMIN_PASSWORD_HASH="replace-with-a-bcrypt-hash"

# Vercel Blob storage token, used for photo uploads in /admin/photography
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""

# Public site URL, used for metadata/Open Graph tags
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Lets the public contact form actually email you (via Gmail SMTP), instead of
# just opening the visitor's own email client. Messages go to whatever email
# is set in /admin/profile, so you can change the destination there anytime.
#
# 1. Turn on 2-Step Verification on the Google account you want to send from:
#    https://myaccount.google.com/security
# 2. Generate an "App Password" for it: https://myaccount.google.com/apppasswords
# 3. Paste that Gmail address and the generated app password below.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Alternative to the two vars above: point at any SMTP provider instead of Gmail
# (e.g. if you outgrow Gmail's sending limits later). If set, these take
# priority over GMAIL_USER/GMAIL_APP_PASSWORD.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
