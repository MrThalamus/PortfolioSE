# PostgreSQL connection string (Supabase, Neon, or any Postgres host)
# Neon example: postgresql://user:password@host/dbname?sslmode=require
# Supabase example: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio"

# Random secret used to sign the admin session cookie (generate with: openssl rand -base64 32)
SESSION_SECRET="replace-with-a-long-random-string"

# Single admin login credentials
ADMIN_USERNAME="admin"
# Generate a bcrypt hash for your password with: npx tsx scripts/hash-password.ts "your-password"
ADMIN_PASSWORD_HASH="replace-with-a-bcrypt-hash"

# Vercel Blob storage token, used for photo uploads in /admin/photography
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""

# Public site URL, used for metadata/Open Graph tags
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
